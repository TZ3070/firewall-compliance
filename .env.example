APP_NAME=bank-firewall-compliance-chatbot
APP_VERSION=0.2.0
DATABASE_PATH=./data/app-v2.db

QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=firewall-standard-knowledge-v1
RAG_MODEL_CACHE_PATH=./data/model-cache
RAG_DENSE_MODEL=BAAI/bge-small-zh-v1.5
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_PREFETCH_LIMIT=20
RAG_ENFORCE_REVIEW_STATUS=true

# 阿里百炼 Embedding；API Key 必须保持为空后再提交。
BAILIAN_EMBEDDING_BASE_URL=
BAILIAN_EMBEDDING_API_KEY=
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_EMBEDDING_TIMEOUT_SECONDS=30

# 阿里百炼 Rerank；API Key 必须保持为空后再提交。
BAILIAN_RERANK_BASE_URL=
BAILIAN_RERANK_API_KEY=
BAILIAN_RERANK_MODEL=qwen3-rerank
BAILIAN_RERANK_TIMEOUT_SECONDS=20
BAILIAN_RERANK_INSTRUCT=Given a compliance search query, retrieve relevant standard passages.

# DeepSeek；API Key 必须保持为空后再提交。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Agent-Compose daemon control plane. Run `agent-compose up`, then copy the
# deployed project ID reported by the daemon into this value.
AGENT_COMPOSE_ENABLED=true
AGENT_COMPOSE_BASE_URL=http://127.0.0.1:7410
AGENT_COMPOSE_AUTH_TOKEN=
AGENT_COMPOSE_PROJECT_ID=
AGENT_COMPOSE_COMPLIANCE_AGENT=firewall-compliance-agent
AGENT_COMPOSE_CONVERSATION_AGENT=conversation-orchestrator
AGENT_COMPOSE_TIMEOUT_SECONDS=15

# Shared only between Agent-Compose sandboxes and the FastAPI tool gateway.
# Generate a long random value; do not commit the real token.
AGENT_TOOL_TOKEN=change-me-before-running
